{
  "target_url": "https://dulms.deltauniv.edu.eg/login.aspx",
  "allowed_hosts": [
    "dulms.deltauniv.edu.eg"
  ],
  "auth": {
    "provider": "custom",
    "username": "42911039",
    "username_selector": "#txtname",
    "password_selector": "#txtPass",
    "submit_selector": "#Button1",
    "success_url_patterns": [
      "/Profile/StudentProfile"
    ],
    "success_selectors": [],
    "failure_selectors": [
      "#errorLbl"
    ],
    "success_on_navigation_without_failure": true
  },
  "browser": {
    "browser": "chromium",
    "headless": true,
    "navigation_timeout_ms": 3000,
    "delay_before_submit_seconds": 0,
    "inter_entry_delay_seconds": 0,
    "viewport_width": 1280,
    "viewport_height": 720,
    "concurrent_windows": 20
  },
  "report": {
    "report_directory": "reports",
    "timestamp_format": "%Y-%m-%dT%H:%M:%S%z",
    "log_level": "INFO",
    "retention_days": 0,
    "diagnostic_verbosity": "minimal"
  },
  "security": {
    "http_status_codes": [
      403,
      429
    ],
    "blocking_text_patterns": [
      "too many attempts",
      "too many requests",
      "rate limit",
      "captcha",
      "temporarily blocked",
      "try again later",
      "account locked",
      "access denied",
      "blocked",
      "suspicious activity",
      "verify you are human"
    ],
    "captcha_selectors": [
      "[data-testid*='captcha']",
      "[id*='captcha']",
      "[class*='captcha']",
      "iframe[src*='recaptcha']",
      "iframe[src*='hcaptcha']",
      ".g-recaptcha",
      "#h-captcha"
    ],
    "mfa_selectors": [
      "[data-testid*='mfa']",
      "[data-testid*='2fa']",
      "[id*='mfa']",
      "[id*='2fa']",
      ".mfa-challenge",
      ".two-factor"
    ]
  },
  "stop_on_security_challenge": true,
  "always_on_top": false,
  "password_file": "password.txt",
  "include_password_in_report": true,
  "resume_enabled": false,
  "resume_state_file": ".auth_resume_state.json"
}